# OpenAI-compatible LLM endpoint used by the summary digest (and, later, ranking).
# Leave unset to run without an LLM — the summary falls back to quiet/empty digests.
#
# Works with any OpenAI-compatible base: Cerebras (default), OpenAI, OpenRouter,
# or a local Ollama. XFEED_LLM_MODEL overrides config.scoring.model when set.
# Get a Cerebras key at https://cloud.cerebras.ai
XFEED_LLM_BASE_URL=https://api.cerebras.ai/v1
XFEED_LLM_API_KEY=
XFEED_LLM_MODEL=gpt-oss-120b

# Chat assistant LLM — its own OpenAI-compatible endpoint/model. The chat tab
# needs a tool-calling–capable model. Falls back to the XFEED_LLM_* vars above
# when these are unset, so configure this only to point chat at a different
# provider/model than the summary digest.
XFEED_CHAT_BASE_URL=https://openrouter.ai/api/v1
XFEED_CHAT_API_KEY=
XFEED_CHAT_MODEL=google/gemma-4-31b-it
