# OpenAI-compatible LLM endpoint used by the summary digest (and, later, ranking).
# Leave unset to run without an LLM — the summary falls back to quiet/empty digests.
#
# Works with any OpenAI-compatible base: OpenAI, OpenRouter, a local Ollama, or
# Claude behind a proxy. XFEED_LLM_MODEL overrides config.scoring.model when set.
XFEED_LLM_BASE_URL=https://api.openai.com/v1
XFEED_LLM_API_KEY=
XFEED_LLM_MODEL=gpt-4o-mini
